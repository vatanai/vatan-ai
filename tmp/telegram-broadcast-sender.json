    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json ?? {};\nconst ids = [...new Set((input.telegram_ids ?? []).map(Number).filter(Number.isInteger))];\nif (input.test_mode !== true || ids.length !== 1) {\n  throw new Error('ارسال عمومی خاموش است؛ تست فقط با test_mode=true و یک شناسه مجاز انجام می‌شود.');\n}\nconst text = String(input.text ?? '').trim();\nif (!text) throw new Error('متن پیام خالی است.');\nreturn ids.map((telegram_id) => ({ json: { telegram_id, text, parse_mode: input.parse_mode ?? 'HTML' } }));"
      },
      "id": "broadcast-guard",
      "name": "Test-only guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.telegram_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "={{ $json.parse_mode }}"
        }
      },
