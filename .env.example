APP_NAME="Vatan AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DISPLAY_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vatan_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@vatan.ai"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── OpenRouter AI ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# چند مسیر پشتیبان با کاما (Failover) — اگر یکی فیلتر/قطع شد، خودکار بعدی:
# OPENROUTER_BASE_URLS=https://<worker>.workers.dev/api/v1,https://openrouter.ai/api/v1
OPENROUTER_GATEWAY_SECRET=
OPENROUTER_TIMEOUT=150
OPENROUTER_MODEL=google/gemini-3.1-flash-image

# ─── Shared AI Provider Settings ─────────────────────────
AI_PROVIDER_TIMEOUT=600
AI_PROVIDER_MAX_RETRIES=2
AI_WEBHOOK_BASE_URL=
AI_WEBHOOK_SECRET=
AI_CATALOG_SYNC_ON_MIGRATE=true
AI_CATALOG_MAX_PAGES=100

# ─── fal.ai ──────────────────────────────────────────────
# FAL_KEY is also accepted for compatibility with the official docs.
FAL_API_KEY=
FAL_KEY=
FAL_ENABLED=false
FAL_BASE_URL=https://queue.fal.run
FAL_PLATFORM_BASE_URL=https://api.fal.ai
FAL_TIMEOUT=180
FAL_MAX_RETRIES=2

# ─── Replicate ────────────────────────────────────────────
REPLICATE_API_TOKEN=
REPLICATE_ENABLED=false
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_TIMEOUT=180
REPLICATE_MAX_RETRIES=2

# Legacy image transformation job (only if this job is still in use)
NANOBANANA_API_KEY=

# ─── Liara AI ───────────────────────────────────────────
LIARA_AI_API_KEY=
LIARA_AI_BASE_URL=https://ai.liara.ir/api/6a6494fdfe9fa573b97b9a9c/v1
LIARA_AI_TIMEOUT=120

# ─── MeliPayamak SMS ────────────────────────────────────
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=
MELIPAYAMAK_BASE_URL=https://console.melipayamak.com/api
MELIPAYAMAK_TIMEOUT=15

# ─── Auth ────────────────────────────────────────────────
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users

VITE_APP_NAME="${APP_NAME}"
LIARA_API_TOKEN=
LIARA_ACCOUNT_API_URL=https://api.liara.ir
OPENROUTER_MANAGEMENT_KEY=
